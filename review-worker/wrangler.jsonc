{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relo2france-review",
  // A topic review streams a 30k-token answer and up to 15 searches; the
  // default 30 s of CPU is too close for comfort.
  "limits": { "cpu_ms": 300000 },
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production",
    "WP_BASE_URL": "https://relo2france.com",
    // Tier, not a model id. The exact model is resolved from the live
    // Anthropic catalogue at call time, so a retired model never gets sent.
    "MODEL_TIER": "sonnet"
  },

  // Caches the Anthropic model catalogue. Replaces the hand-rolled WordPress
  // transient plus failure backoff.
  "kv_namespaces": [
    { "binding": "MODEL_CACHE", "id": "2e9eda58e4244b3ba10ba42ceedcd622" }
  ],

  // One step per topic. Steps have unlimited wall time, so a five-minute
  // topic is fine, and a failure retries that topic rather than the run.
  "workflows": [
    {
      "name": "relo2france-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow"
    },
    {
      "name": "relo2france-gap-workflow",
      "binding": "GAP_WORKFLOW",
      "class_name": "GapWorkflow"
    },
    {
      "name": "relo2france-report-workflow",
      "binding": "REPORT_WORKFLOW",
      "class_name": "ReportWorkflow"
    }
  ],

  // Sunday 03:00 UTC. Written as SUN, not 0: Cloudflare numbers weekdays
  // 1-7 with 1 = Sunday, so "0" is rejected outright and "1" would silently
  // mean Sunday where most cron systems read it as Monday.
  "triggers": {
    "crons": [
      // The full review, weekly.
      "0 3 * * SUN",
      // Gap drafting, daily and cheap - at most three gaps a pass.
      "0 4 * * *"
    ]
  }

  // Secrets, set with `wrangler secret put`:
  //   ANTHROPIC_API_KEY  - the same key WordPress uses
  //   WP_SHARED_SECRET   - matches the Review API secret in WP settings
  //   TRIGGER_SECRET     - guards the manual trigger route
  //
}
