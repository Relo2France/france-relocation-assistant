<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_preview.xml

  Preview layout shown when selecting widget from the widget picker.

  @package MyTravelStatus
  @since   1.8.3
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇪🇺"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Schengen"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="45"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#22C55E" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/ 90 days"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray" />

    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progress="50"
        android:progressTint="#22C55E"
        android:progressBackgroundTint="#E5E7EB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="45 days left"
        android:textSize="10sp"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>
