{
    "name": "relo2france/mytravelstatus",
    "description": "Travel day tracking and compliance for Schengen 90/180 rule",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "minishlink/web-push": "^8.0",
        "tecnickcom/tcpdf": "^6.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MTS\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "install-wp-tests": "bash bin/install-wp-tests.sh wordpress_test root '' localhost latest"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "yoast/phpunit-polyfills": true
        }
    }
}
